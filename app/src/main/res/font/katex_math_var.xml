    <font android:font="@font/katex_ams_regular" android:fontStyle="normal" android:fontWeight="400" />
    <font android:font="@font/katex_size1_regular" android:fontStyle="normal" android:fontWeight="400" />
    <font android:font="@font/katex_size2_regular" android:fontStyle="normal" android:fontWeight="400" />
    <font android:font="@font/katex_script_regular" android:fontStyle="normal" android:fontWeight="400" />
    <font android:font="@font/katex_caligraphic_regular" android:fontStyle="normal" android:fontWeight="400" />
</font-family>
