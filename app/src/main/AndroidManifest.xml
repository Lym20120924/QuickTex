<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FormulaStudio">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LibraryActivity"
            android:exported="false"
            android:label="@string/library_title" />

        <activity
            android:name=".AppearanceActivity"
            android:exported="false"
            android:label="@string/appearance_title"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".DocumentActivity"
            android:exported="false"
            android:label="@string/document_title"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.formulastudio.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
        android:name=".pdf.PdfViewerActivity"
        android:exported="false"
        android:label="@string/pdf_viewer_title" />
    <activity
        android:name=".ui.DesignSystemActivity"
        android:exported="false"
        android:label="@string/design_system_title" />
    <activity
        android:name=".ui.FormulaEditorComposeActivity"
        android:exported="false"
        android:label="@string/title_compose_editor" />
    <activity
        android:name=".ui.ComposeRenderActivity"
        android:exported="true"
        android:label="Compose 渲染验证" />
    <activity
        android:name=".ui.RenderCompareActivity"
        android:exported="true"
        android:label="渲染后端对比" />
    <activity
        android:name=".docx.DocxViewerActivity"
        android:exported="true"
        android:label="@string/docx_viewer_title">
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
        </intent-filter>
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="content" android:host="*" android:pathPattern=".*\.docx" />
        </intent-filter>
    </activity>
</application>

</manifest>
